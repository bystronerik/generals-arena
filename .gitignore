.DS_Store
.venv/
__pycache__/
*.egg-info/
.env
.pytest_cache/
.idea/
.env.agent

# Arena data (keep .gitkeep; commit round reports under docs/research/measurements/)
data/games/*.json
data/games/**/*.json
data/ratings/*.json
data/ratings/**/*.json
data/ratings/leaderboard.md

# data/bot_versions/ is deliberately NOT ignored: the bot version registry is a
# reviewable source artifact, not derived data. `git log -p
# data/bot_versions/<bot>.json` is a bot's improvement history. The rules above
# are file globs scoped to data/games/ and data/ratings/, so no carve-out is
# needed here — tests/test_registry.py asserts it stays that way.

# Submission bundles are derived artifacts (python -m arena.bundle <bot>)
data/bundles/

# Live generals.io session logs (classic rules; not arena Elo)
data/remote_games/*.json

# Classic-approximate local harness (not competition Elo)
data/classic_games/*.json

# Per-turn trajectories (derived, opt-in; see docs/arena/trajectories.md)
data/trajectories/**

# Scraped generals.bot leaderboard replays (~0.6 MB each, hundreds of MB per
# player; re-fetchable with scripts/scrape_replays.py). Keep the directory.
competition-replays/*
!competition-replays/.gitkeep

# Morpheus local shards, checkpoints, and materializations (derived; Modal
# Volumes are primary for remote runs). Keep the directory.
data/morpheus/*
!data/morpheus/.gitkeep

# Joe local checkpoint dirs (derived; the Modal Volume and the R2 bucket are
# primary for remote runs). Keep the directory.
data/joe/*
!data/joe/.gitkeep

# Joe deployed weights (~33 MB float32) are re-fetchable from R2 by the
# manifest's r2_key + sha256 (scripts/joe_export_bot.py). The committed
# manifest.json pins exactly which weights a checkout is missing; the content
# hash still covers the .eqx, so an export forks the rating identity.
bots/joe/artifact/*.eqx
# `bots/joe_base/` is a frozen copy of an earlier joe checkpoint, kept only
# for the duration of one comparison (decision-rule.md: cross-round baselines
# are not comparators). Same weights rule.
bots/joe_base/artifact/*.eqx

# joe-rs weights follow the same rule as joe's: derived from the joe artifact
# by bots/joe-rs/tools/convert_artifact.py, pinned by the committed
# manifest.json (safetensors_sha256), re-creatable on any checkout that has
# the joe .eqx. The content hash still covers the .safetensors, so a
# re-conversion forks the rating identity. Build output stays out of the
# tree like morpheus-rs's.
bots/joe-rs/artifact/*.safetensors
bots/joe-rs/target/

# Curriculum manifests are rebuilt from trajectories; keep the directory.
training/morpheus/manifests/*
!training/morpheus/manifests/.gitkeep

# Morpheus shaping variants (scripts/morpheus_shaping_variant.py) are measurement
# arms, not bots: materialized for one comparison, then deleted. The settings
# that define them live in the plan and the measurement report, so a variant
# directory is derived data even though it sits under bots/.
bots/morpheus-*/

# ...but morpheus-rs is a real sibling bot with its own lineage, not a variant
# (docs/bots/morpheus-rs/rewrite-plan.md §10). Carve it back out of the rule
# above, and keep its build output and vendored crates out of the tree.
!bots/morpheus-rs/
bots/morpheus-rs/target/
bots/morpheus-rs/vendor/
# The minifier is a dev-time helper crate with its own build output. Its
# sources are committed; what it compiles to is not.
tools/rust-minify/target/
