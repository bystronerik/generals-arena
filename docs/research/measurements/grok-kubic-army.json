    },
    {
      "id": "R3_sustained_move_start_size",
      "tag": "MEASURED",
      "claim": "Sustained tip marches (>= 5 consecutive max-stack moves) typically start with tip army in the mid-teens (p25~9, p75~25).",
      "thresholds": {
        "sustained_move_min_ticks": 5,
        "unit": "consecutive max-stack move ticks",
        "streak_start_army_median": 15.0,
