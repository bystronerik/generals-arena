  "rules": [
    {
      "id": "R1_tip_not_general_bank",
      "tag": "MEASURED",
      "claim": "Tip stack holds more army than the general bank across the game (median mean_tip_frac ~2x mean_gen_frac). Most army still sits on ordinary land; castles hold a small extra bank.",
      "thresholds": {
        "mean_tip_frac_median": 0.25146804547320817,
        "mean_gen_frac_median": 0.1326788155057153,
        "mean_castle_frac_median": 0.054259208968956495
      }
    },
    {
      "id": "R2_gather_before_sight",
      "tag": "MEASURED",
      "claim": "Every fit win has >=1 gather_wave (max-stack grows while moving >= 5 ticks). Most waves start before first_general_sight; waves begin near home and end closer to the enemy general.",
      "thresholds": {
        "gather_min_ticks": 5,
        "unit": "ticks of consecutive growing moves",
        "pre_sight_wave_share": 0.7247990105132962,
        "waves_per_game_median": 4.0,
        "zero_wave_wins": 0,
        "wave_start_dist_home_median": 2.0,
        "wave_end_dist_enemy_gen_median": 13.0
